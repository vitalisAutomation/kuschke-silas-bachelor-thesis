    "flowchart": {
        "useMaxWidth": true,
        "htmlLabels": false,
        "nodeSpacing": 28,
        "rankSpacing": 58,
        "padding": 12,
        "curve": "basis"
    }
}}%%
flowchart TD
    Start([Start prepare_raspberry_pi.bat]) --> Init["UTF-8, ANSI-Farben und Projektpfad setzen<br>Ubuntu-Version, Netzwerk und SSH-Defaults laden"]
    Init --> SSHKey["SSH-Schluessel erzeugen oder wiederverwenden<br>%USERPROFILE%\\.ssh\\id_rsa_ctrlx_pi"]
    SSHKey --> DependencyCheck[":CHECK_DEVELOPMENT_TOOLS<br>Raspberry Pi Imager, VS Code und Extensions pruefen"]
    DependencyCheck --> MissingDeps{"Fehlende<br>Entwicklungstools?"}
    MissingDeps -- Ja --> Admin[":REQUEST_ADMIN<br>PowerShell startet das Skript mit Administratorrechten"]
    Admin --> InstallDeps[":INSTALL_DEPENDENCIES<br>VS Code und benoetigte Extensions installieren"]
    InstallDeps --> MainMenu
    MissingDeps -- Nein --> MainMenu

    subgraph Menu["Hauptmenue :START_MENU"]
        direction TB
        MainMenu["Raspberry-Pi-Vorbereitung"] --> Choice{"Aktion waehlen"}
        Choice -- "1: Bestehenden Pi verbinden" --> ConnectSSH
        Choice -- "2: Ubuntu herunterladen und SD-Karte flashen" --> OSChoice
        Choice -- "3: Beenden" --> Exit([Skript beendet])
    end

    subgraph Existing["Option 1: Bestehenden Raspberry Pi verbinden"]
        direction TB
        ConnectSSH["Pi-Host oder IP abfragen<br>Standard: 192.168.1.100 / sdk-pi.local"] --> SSHConfig["configure_vscode_remote_ssh.ps1<br>localServerDownload = never"]
        SSHConfig --> Alias["configure_raspberry_pi_ssh.ps1<br>SSH-Alias ctrlx-pi konfigurieren"]
        Alias --> SSHTest{"SSH-Verbindung<br>erreichbar?"}
        SSHTest -- Nein --> HostKey{"Host-Key geaendert?"}
        HostKey -- Ja --> RemoveKey["Bekannten Host-Key nach Bestaetigung entfernen<br>Verbindung mit accept-new wiederholen"] --> SSHTest
        HostKey -- Nein --> SSHError["Fehler anzeigen<br>zurueck zum Hauptmenue"] --> MainMenu
        SSHTest -- Ja --> OpenCode["VS Code Remote-SSH oeffnen<br>/home/sdk-pi"]
        OpenCode --> PiExtensions["Auf code-server warten<br>Remote-Extensions installieren"]
        PiExtensions --> MainMenu
    end

    subgraph Flash["Option 2: SD-Karte vorbereiten und Raspberry Pi provisionieren"]
        direction TB
        OSChoice["Ubuntu-Ziel waehlen"] --> Version{"Ubuntu-Version?"}
        Version -- "22.04.5" --> Image22["Ubuntu Server 22.04.5 LTS ARM64<br>ctrlX OS 1.x / 2.x / 3.x"]
        Version -- "24.04.3" --> Image24["Ubuntu Server 24.04.3 LTS ARM64<br>ctrlX OS 4.x"]
        Image22 --> ProxyCheck
        Image24 --> ProxyCheck
        ProxyCheck[":PREPARE_NETWORK<br>Proxy-Modus und PC-Netzwerk pruefen"] --> ProxyMode{"Proxy aktiviert?"}
        ProxyMode -- Ja --> ProxyConfig["Proxy-URL pruefen<br>Windows und Raspberry Pi vorbereiten"]
        ProxyMode -- Nein --> DirectNetwork["Direkte Internetverbindung"]
        ProxyConfig --> Download
        DirectNetwork --> Download
        Download["Ubuntu-Image und SHA256-Pruefsumme herunterladen"] --> Verify["Archiv pruefen und IMG-Datei extrahieren"]
        Verify --> Imager["Raspberry Pi Imager CLI starten<br>Physisches Geraet statt Laufwerksbuchstabe verwenden"]
        Imager --> DriveChoice["SD-Karte auswaehlen<br>Alle Daten auf dem Ziel werden geloescht"]
        DriveChoice --> WiFi
        WiFi["Wi-Fi-SSID und Passwort abfragen<br>Hotspot muss Internetzugriff bereitstellen"] --> CloudInit
    end

    subgraph Provision["Cloud-Init-Konfiguration :CONFIGURE_FIRST_BOOT"]
        direction TB
        CloudInit["configure_cloud_init.ps1 ausfuehren"] --> SeedFiles["NoCloud-Dateien auf der Boot-Partition schreiben<br>meta-data, user-data, network-config"]
        SeedFiles --> UserConfig["Benutzer sdk-pi anlegen<br>Sudo ohne Passwort und SSH-Public-Key"]
        UserConfig --> NetworkConfig["Netzwerk konfigurieren<br>eth0: 192.168.1.100/24 statisch<br>wlan0: DHCP ueber Wi-Fi-Hotspot"]
        NetworkConfig --> SystemConfig["Locale de_DE.UTF-8, Zeitzone Europe/Berlin<br>Wi-Fi-Land DE und SSH aktivieren"]
        SystemConfig --> SDKConfig["ctrlX SDK, Snapcraft und benoetigte Pakete<br>ueber runcmd installieren"]
        SDKConfig --> LoggingConfig["USB-Logging einrichten<br>Label CTRLXLOG -> /mnt/ctrlx-logs"]
        LoggingConfig --> ConsoleConfig["TTY1 und serielle Gettys konfigurieren<br>Autologin fuer sdk-pi"]
        ConsoleConfig --> Cmdline["cmdline.txt bereinigen und ergaenzen<br>ds=nocloud und cfg80211.ieee80211_regdom=DE"]
    end

    Cmdline --> Eject[":EJECT_SD_CARD<br>SD-Karte sicher auswerfen"]
    Eject --> Boot["SD-Karte in den Raspberry Pi einsetzen<br>und Pi starten"]
    Boot --> FirstBoot{"Cloud-Init und<br>Netzwerk bereit?"}
    FirstBoot -- Nein --> BootError["Diagnoseprotokolle pruefen<br>Boot-Partition oder USB-Log CTRLXLOG"] --> MainMenu
    FirstBoot -- Ja --> Ready["Raspberry Pi ist bereit<br>Ethernet: 192.168.1.100<br>SSH: ctrlx-pi"]
    Ready --> MainMenu

    style Menu fill:#ffe4e4,stroke:#c62828,stroke-width:3px,color:#7f1d1d
    style Existing fill:#e3f2fd,stroke:#1976d2,stroke-width:2px
    style Flash fill:#fce4ec,stroke:#ad1457,stroke-width:2px,color:#880e4f
    style Provision fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20
    style MainMenu fill:#fff8e1,stroke:#f9a825,stroke-width:1px,color:#6d4c00
    style Choice fill:#fff8e1,stroke:#f9a825,stroke-width:1px,color:#6d4c00
    style OSChoice fill:#fff8e1,stroke:#f9a825,stroke-width:1px,color:#6d4c00
    style Version fill:#fff8e1,stroke:#f9a825,stroke-width:1px,color:#6d4c00
    style ProxyMode fill:#eef7ff,stroke:#2f80ed,stroke-width:1px,color:#0f172a
    style FirstBoot fill:#eef7ff,stroke:#2f80ed,stroke-width:1px,color:#0f172a
