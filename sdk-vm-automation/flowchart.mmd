    %%{init: {
    "theme": "base",
    "themeVariables": {
        "fontFamily": "Segoe UI, Arial, sans-serif",
        "fontSize": "20px",
        "primaryColor": "#eef7ff",
        "primaryBorderColor": "#2f80ed",
        "primaryTextColor": "#0f172a",
        "secondaryColor": "#f3fbf6",
        "secondaryBorderColor": "#2d9d78",
        "secondaryTextColor": "#0f172a",
        "tertiaryColor": "#fff8e8",
        "tertiaryBorderColor": "#d58a00",
        "tertiaryTextColor": "#0f172a",
        "lineColor": "#4b5563",
        "background": "#ffffff",
        "clusterBkg": "#f8fbff",
        "clusterBorder": "#9ec5ff"
    },
    "flowchart": {
        "useMaxWidth": false,
        "htmlLabels": true,
        "nodeSpacing": 90,
        "rankSpacing": 130,
        "padding": 30,
        "curve": "basis"
    }
    }}%%
    flowchart LR
        Start([Start des Skripts]) --> Init["UTF-8 aktivieren, Farbcodes definieren & Pfade setzen"]
        Init --> CheckArg{"Argument %1 == '-install'?"}
        
        %% Phase 1: Prüfung & Admin-Anforderung
        CheckArg -- Nein --> InitCheck["Abhängigkeiten prüfen"]
        InitCheck --> CallCheckDeps["call :CHECK_ALL_DEPS"]
        CallCheckDeps --> CheckDepsRes{MISSING_DEPS definiert?}
        CheckDepsRes -- Ja --> ReqAdmin["Phase 1: :REQUEST_ADMIN<br>Fehlende Abhängigkeiten anzeigen"]
        ReqAdmin --> PressKey["Warte auf Tastendruck"]
        PressKey --> BuildArgs["Argument-String für Powershell bauen"]
        BuildArgs --> Elevate["Powershell: Neustart als Admin mit '-install'"]
        Elevate --> ExitOld["Altes Skript-Fenster schließen"]
        
        %% Phase 2: Admin-Installation
        CheckArg -- Ja --> InstallDeps["Phase 2: :INSTALL_DEPS<br>System-Abhängigkeiten installieren"]
        InstallDeps --> CheckVSCode{"'-install-vscode' in Argumenten?"}
        CheckVSCode -- Ja --> DLVSCode["VS Code herunterladen & silent installieren"] --> CheckExt
        CheckVSCode -- Nein --> CheckExt
        
        CheckExt{"'-install-extensions' in Argumenten?"}
        CheckExt -- Ja --> InstallExt["VS Code Extensions per Schleife installieren"] --> CheckQemu
        CheckExt -- Nein --> CheckQemu
        
        CheckQemu{"'-install-qemu' in Argumenten?"}
        CheckQemu -- Ja --> DLQemu["QEMU herunterladen & silent in Projektordner installieren"] --> MainMenu
        CheckQemu -- Nein --> MainMenu
        
        %% Hauptmenü
        CheckDepsRes -- Nein --> MainMenu
        
        subgraph main_menu ["Hauptmenü [:MAIN_MENU]"]
            MainMenu["Zustand prüfen: Vorhandene VMs & QEMU-Modus ermitteln"] --> ShowMenu["Hauptmenü anzeigen"]
            ShowMenu --> UserChoice{Eingabe Option 1, 2 oder 3?}
            UserChoice -- Option 1 --> StartVM["Vorhandene VM starten"]
            UserChoice -- Option 2 --> DLVM["Neue VM einrichten"]
            UserChoice -- Option 3 --> Exit([Skript beenden])
        end
        
        %% Option 1: VM starten
        StartVM --> ChooseStart["VM-Version wählen: Core 22 oder Core 24"]
        ChooseStart --> CheckVMExist{Existiert VM-Datei .qcow2?}
        CheckVMExist -- Nein --> ShowVMErr["Fehlermeldung anzeigen"] --> MainMenu
        CheckVMExist -- Ja --> SetCoreVer["CORE_VER setzen"] --> QemuStart
        
        %% Option 2: VM einrichten
        DLVM --> ChooseOS["ctrlX OS Zielversion wählen"]
        ChooseOS --> SetVMVars["CORE_VER & DOWNLOAD_TARGET=VM setzen"] --> ProxyCheck
        
        %% Proxy-Subsystem
        subgraph proxy_check ["Proxy-Abfrage [:NET_PROXY_CHECK]"]
            ProxyCheck["Arbeitsumgebung wählen"] --> ProxyChoice{Welche Umgebung?}
            ProxyChoice -- 1: Bosch-Proxy --> BoschSetup["Lokalen Bosch-Proxy http://127.0.0.1:3128 setzen<br>Hinweis auf RB Local Proxy Manager"] --> RouteDL
            ProxyChoice -- 2: Firmen-Proxy --> ExtSetup{Existiert proxy.env?}
            ExtSetup -- Ja --> LoadEnv["Lese proxy.env ein & setze PROXY_URL"] --> RouteDL
            ExtSetup -- Nein --> CreateEnv["Erzeuge proxy.env Dummy & Abbruch"] --> MainMenu
            ProxyChoice -- 3: Direkt/Kein Proxy --> NoProxy["Direkte Verbindung"] --> RouteDL
        end
        
        %% VM Download & Provisionierung
        RouteDL --> DLVMStart["Phase :DOWNLOAD_VM<br>Cloud-Image der VM herunterladen"]
        DLVMStart --> SSHGen["SSH-Schlüssel generieren & config beschreiben"]
        SSHGen --> CloudInit["Cloud-Init Config erzeugen<br>meta-data, user-data mit setup-sdk.sh, network-config"]
        CloudInit --> DLMkisofs["mkisofs.exe herunterladen falls fehlt"]
        DLMkisofs --> GenISO["seed.iso via mkisofs.exe generieren"]
        GenISO --> Validate["ISO-Inhalt validieren & Größen prüfen"] --> QemuStart
        
        %% QEMU Laufzeit
        subgraph start_qemu ["VM Ausführung [:START_QEMU_VM]"]
            QemuStart["VM-Start vorbereiten"] --> CheckSeed{Existiert seed.iso?}
            CheckSeed -- Nein --> GenISO
            CheckSeed -- Ja --> RunQemu["QEMU headless starten<br>Portweiterleitung Host:11022 -> VM:22"]
            RunQemu --> CheckErr{Fehler in qemu_error.log?}
            CheckErr -- Ja --> ShowLog["Fehlerprotokoll in Notepad öffnen"] --> PostRun
            CheckErr -- Nein --> PostRun
            PostRun["Warte auf Bestätigung"] --> MainMenu
        end
